# Copy to .env.local and fill in NOTION_TOKEN yourself. Never commit .env.local.
# Create an internal integration at https://www.notion.so/profile/integrations,
# then share the page "App Data (written by FreshCart and ClinicBook)" with it.
NOTION_TOKEN=
# Page that holds the six CB databases (not a secret). This is the default.
NOTION_PARENT_PAGE_ID=41d2b9c9-59ab-81b3-ba6f-eda97451cd66
# notion or memory. Default: notion when NOTION_TOKEN is set, otherwise memory.
STORAGE=
# Shared password of the three staff test accounts. The facilitator chooses it.
TRAINING_PASSWORD=
